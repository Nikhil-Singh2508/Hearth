POSTGRES_DB=rental
POSTGRES_USER=rental
POSTGRES_PASSWORD=replace-with-a-long-random-local-secret
DATABASE_URL=postgresql+psycopg://rental:replace-with-a-long-random-local-secret@localhost:5433/rental
APP_ENV=development
COOKIE_SECURE=false
CORS_ORIGINS=["http://localhost:5173"]

# Supabase database: copy the Session pooler URI from Project > Connect and
# change its scheme to postgresql+psycopg://; keep sslmode=require.
# Leave the local DATABASE_URL above when using Docker PostgreSQL locally.

# Optional Supabase private file storage. Create this bucket as PRIVATE first.
PRIVATE_STORAGE_BACKEND=local
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=hearth-private

# Optional tenant payment receipts by email (Resend). Use a verified sender domain.
RESEND_API_KEY=
EMAIL_FROM=

# Optional WhatsApp payment receipts (Meta WhatsApp Cloud API).
# The approved template must contain four body placeholders, in order:
# tenant name, amount, payment method, received timestamp.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=
WHATSAPP_PAYMENT_TEMPLATE=payment_receipt
WHATSAPP_TEMPLATE_LANGUAGE=en_US
